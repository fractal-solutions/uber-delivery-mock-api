# Server port
PORT=3000

# Fixed credentials accepted by POST /auth
CLIENT_ID=test-client-id
CLIENT_SECRET=test-client-secret

# Endpoint that receives webhook events (leave empty to disable webhooks)
WEBHOOK_URL=

# Delivery simulation timing in milliseconds:
# pending -> pickup -> pickup_complete -> dropoff -> delivered
PENDING_MS=10000
PICKUP_MS=10000
PICKUP_COMPLETE_MS=20000
DROPOFF_MS=120000

# Webhook cadence in milliseconds
WEBHOOK_INTERVAL_MS=20000
COURIER_UPDATE_INTERVAL_MS=10000

# Fee range used by /deliveries and delivery_quotes when no fee is supplied
MIN_FEE=5
MAX_FEE=50
